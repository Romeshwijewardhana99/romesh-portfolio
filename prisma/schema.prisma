generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum TechnologyCategory {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  DEVOPS
  TOOL
  OTHER
}

/**
 * =========================================================
 * ADMIN USERS
 * =========================================================
 */

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

/**
 * =========================================================
 * PROJECTS
 * =========================================================
 */

model Project {
  id               Int    @id @default(autoincrement())
  title            String
  slug             String @unique
  shortDescription String @db.VarChar(500)
  description      String @db.LongText

  problem    String? @db.LongText
  solution   String? @db.LongText
  challenges String? @db.LongText
  outcome    String? @db.LongText

  coverImage String?

  githubUrl String?
  liveUrl   String?

  clientName  String?
  projectType String?

  status    ProjectStatus @default(DRAFT)
  featured  Boolean       @default(false)
  sortOrder Int           @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images       ProjectImage[]
  technologies ProjectTechnology[]
  testimonials Testimonial[]

  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@map("projects")
}

/**
 * =========================================================
 * PROJECT IMAGES
 * =========================================================
 */

model ProjectImage {
  id        Int @id @default(autoincrement())
  projectId Int

  imageUrl  String
  altText   String?
  caption   String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sortOrder])
  @@map("project_images")
}

/**
 * =========================================================
 * TECHNOLOGIES
 * =========================================================
 */

model Technology {
  id   Int     @id @default(autoincrement())
  name String  @unique
  slug String  @unique
  icon String?

  category TechnologyCategory @default(OTHER)

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectTechnology[]

  @@index([category])
  @@index([isVisible])
  @@index([sortOrder])
  @@map("technologies")
}

/**
 * =========================================================
 * PROJECT <-> TECHNOLOGY MANY-TO-MANY
 * =========================================================
 */

model ProjectTechnology {
  projectId    Int
  technologyId Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

/**
 * =========================================================
 * SERVICES
 * =========================================================
 */

model Service {
  id               Int     @id @default(autoincrement())
  title            String
  slug             String  @unique
  shortDescription String  @db.VarChar(500)
  description      String? @db.LongText
  icon             String?

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible])
  @@index([sortOrder])
  @@map("services")
}

/**
 * =========================================================
 * TESTIMONIALS
 * =========================================================
 */

model Testimonial {
  id Int @id @default(autoincrement())

  clientName String
  clientRole String?
  company    String?
  avatarUrl  String?

  quote  String @db.Text
  rating Int?

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  projectId Int?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isVisible])
  @@index([sortOrder])
  @@map("testimonials")
}

/**
 * =========================================================
 * CLIENT INQUIRIES
 * =========================================================
 */

model Inquiry {
  id Int @id @default(autoincrement())

  name    String
  email   String
  phone   String?
  company String?

  service  String?
  budget   String?
  timeline String?

  message String @db.LongText

  status InquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

/**
 * =========================================================
 * SITE SETTINGS
 * =========================================================
 */

model SiteSetting {
  id Int @id @default(autoincrement())

  siteName String @default("Romesh Portfolio")

  heroBadge    String?
  heroTitle    String?
  heroSubtitle String? @db.Text

  email    String?
  phone    String?
  whatsapp String?
  location String?

  githubUrl    String?
  linkedinUrl  String?
  facebookUrl  String?
  instagramUrl String?

  profileImage         String?
  profileImagePublicId String?

  resumeUrl String?

  availableForWork Boolean @default(true)

  seoTitle       String?
  seoDescription String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
